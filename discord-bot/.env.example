# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# The ID of the voice channel the bot should join
VOICE_CHANNEL_ID=

# The ID of the guild (server) the bot is in
GUILD_ID=

# URL of the deployed web app (e.g. https://your-app.vercel.app)
WEBAPP_URL=http://localhost:3000

# Shared secret for authenticating with the web app API
API_SECRET=
